--!nocheck

local NOW = 1792281600
local cases = {}
for _, case in ipairs(wsFixtures.threats) do
    cases[case.name] = case.raw
end
local function prepare(env)
    env.now = NOW
    for raw, value in pairs(wsJsonValues) do
        env.jsonValues[raw] = value
    end
    return env
end
local env = prepare(runtime())
local decoder = env.require("./alerts/events.luau")
local catalog = env.require("./locations/catalog.luau")
local threats = env.require("./alerts/threats.luau")
local function decoded(name)
    return assert(decoder.decode(assert(cases[name])))
end
local selected = assert(catalog.find("raion:бориспільський"))
local localThreat = decoded("local").data
assert(localThreat.locationKey == selected.key)
assert(localThreat.title == "Шахед" and localThreat.locality == "Бориспіль")
assert(localThreat.heading == 90 and localThreat.count == 2)
assert(localThreat.explanationShort == "БпЛА курсом на Бориспіль")
assert(threats.matches(localThreat, selected) and threats.isCurrent(localThreat, NOW * 1000))
assert(threats.isCurrent(localThreat, (NOW + 420) * 1000))
assert(not threats.isCurrent(localThreat, (NOW + 421) * 1000))
assert(threats.matches(decoded("district-without-region").data, selected))
assert(threats.matches(decoded("broad").data, selected))
assert(not threats.matches(decoded("other-district").data, selected))
assert(threats.matches(decoded("other-district").data, catalog.find("київська")))
assert(not threats.matches(decoded("kyiv-city").data, selected))
assert(not threats.matches(localThreat, catalog.find("м. київ")))
assert(threats.matches(decoded("kyiv-city").data, catalog.find("м. київ")))
assert(threats.matches(decoded("unknown-district").data, catalog.find("київська")))
for _, name in ipairs({ "conflicting-parent", "unknown-region", "unknown-district", "invalid-district", "outside" }) do
    assert(not threats.matches(decoded(name).data, selected), name)
end
for _, name in ipairs({ "stale", "resolved", "old", "future", "invalid-time", "unknown-status", "no-time", "no-status" }) do
    assert(not threats.isCurrent(decoded(name).data, NOW * 1000), name)
end
local invalid = decoded("invalid-optional").data
assert(invalid.heading == nil and invalid.count == nil and invalid.title == nil)
assert(invalid.explanationShort == nil and invalid.locality == nil and invalid.confidenceLevel == nil)
assert(decoded("invalid-heading").data.heading == nil)
assert(decoded("invalid-heading").data.count == nil)
assert(decoded("north").data.heading == 0)
local reducer = env.require("./alerts/realtime-store.luau")
local model = reducer.new()
assert(reducer.apply(model, decoded("local"), 1))
assert(reducer.apply(model, decoded("update-local"), 2), "metadata changes with the same timestamp must be retained")
assert(model.threats[localThreat.id].locality == "Гнідин")
assert(not reducer.apply(model, decoded("update-local"), 3))
print("PASS threat metadata validation, explicit geography, city separation, age and store updates")

local presentation = env.require("./ui/threat-presentation.luau")
local summary, body, urgency = presentation.forThreat(localThreat, "new")
assert(summary == "Шахед ×2 · Нова ціль")
assert(body == "• Бориспіль\n• БпЛА курсом на Бориспіль")
assert(not body:find("new-local", 1, true) and not body:find("18.10.2026", 1, true))
assert(#presentation.details(localThreat) == 3)
assert(urgency == "critical")
local broadSummary, broadBody = presentation.forThreat(decoded("broad").data, "new")
assert(broadSummary == "Шахед ×2 · Нова ціль")
assert(broadBody:find("Київська область", 1, true))
assert(not broadBody:find("90°", 1, true))
local _, lowBody = presentation.forThreat(decoded("low-confidence").data, "new")
assert(not lowBody:find("90°", 1, true))
local _, northBody = presentation.forThreat(decoded("north").data, "new")
assert(not northBody:find("°", 1, true))
local advisorySummary, advisoryBody, advisoryUrgency = presentation.forThreat(decoded("advisory").data, "new")
assert(advisorySummary:find("Спостереження", 1, true) and advisoryUrgency == "normal")
local unknownSummary, unknownBody, unknownUrgency = presentation.forThreat(decoded("unknown-type").data, "new")
assert(unknownSummary:find("Невідома загроза: future-threat", 1, true) and unknownUrgency == "normal")
env.require("./notification.luau").sendThreat(localThreat, "new")
assert(env.notifications[1].body == body and env.notifications[1].urgency == urgency)
assert(env.notifications[1].timeout_ms == 15000 and env.notifications[1].icon == "brand-flightradar24")
assert(env.commands[1][1] == "noctalia" and type(env.commands[1]) == "table")
print("PASS threat notification content, source direction text, broad scope, observations and unknown types")

local function serviceFor(key)
    local service = prepare(runtime())
    service.files["/data/config.json"] = "saved"
    service.jsonValues.saved = { locationKey = key }
    service.require("./service.luau")
    service.update()
    return service
end
local function push(service, name)
    service.streams[1].onLine(assert(cases[name], name))
    service.flush()
end
local service = serviceFor(selected.key)
local first, second = runtime(service.shared), runtime(service.shared)
first.require("./widget.luau")
second.require("./widget.luau")
push(service, "local")
assert(#service.notifications == 0, "no notifications before the threat snapshot")
push(service, "snapshot")
assert(#service.notifications == 0, "startup snapshot is a silent baseline")
push(service, "local")
assert(#service.notifications == 1)
push(service, "update-local")
push(service, "update-local")
assert(#service.notifications == 2, "changed details notify once; identical updates stay silent")
assert(service.notifications[2].summary:find("Оновлення цілі", 1, true))
assert(service.notifications[2].body:find("Гнідин", 1, true))
push(service, "other-district")
push(service, "outside")
assert(#service.notifications == 2)
push(service, "moves-in")
assert(#service.notifications == 3, "notify when a tracked target first enters the selected scope")
push(service, "broad")
assert(#service.notifications == 4 and service.notifications[4].summary == broadSummary)
for _, name in ipairs({ "stale", "resolved", "old", "future", "invalid-time", "no-time", "no-status", "unknown-status", "conflicting-parent", "invalid-district" }) do
    push(service, name)
    assert(#service.notifications == 4, name)
end
push(service, "advisory")
assert(#service.notifications == 5 and service.notifications[5].urgency == "normal")
push(service, "reconnect")
push(service, "local")
assert(#service.notifications == 5, "reconnect snapshot must not replay existing threats")
push(service, "new-local")
assert(#service.notifications == 6)
push(service, "outside")
local store = service.require("./locations/store.luau")
assert(store.save(catalog.find("raion:львівський")))
service.flush()
push(service, "outside")
assert(#service.notifications == 6, "location changes establish a silent baseline")
assert(store.save(selected))
service.flush()
push(service, "local")
push(service, "new-local")
assert(#service.notifications == 6, "A → B → A must not replay known targets")
push(service, "remove")
assert(#service.notifications == 7 and service.notifications[7].urgency == "normal")
assert(service.notifications[7].summary:find("Ціль втрачено", 1, true))
push(service, "remove")
assert(#service.notifications == 7, "duplicate removal must stay silent")
push(service, "local")
assert(#service.notifications == 8, "a removed target may be reported again as a new appearance")
assert(first.text == second.text and #first.notifications == 0 and #second.notifications == 0)
assert(service.streamAttempts == 1 and #service.requests == 0)
assert(first.streamAttempts == 0 and second.streamAttempts == 0)
print("PASS single-service threat notifications, deduplication, movement, reconnect and location changes")

local silent = serviceFor(selected.key)
push(silent, "empty-snapshot")
silent.now = NOW + 30
push(silent, "local")
assert(#silent.notifications == 1)
silent.now = NOW + 60
push(silent, "latest-time")
assert(#silent.notifications == 2, "threat messages remain useful while official alerts await synchronization")
assert(silent.values.alertStatus.kind == "error")
silent.now = NOW + 110
silent.update()
push(silent, "third-local")
assert(#silent.notifications == 2, "silence must invalidate the threat baseline even after official sync expiry")
silent.now = NOW + 120
push(silent, "empty-snapshot")
push(silent, "after-recovery")
assert(#silent.notifications == 3, "fresh snapshot restores threat notifications")
assert(silent.values.alertStatus.kind ~= "alert", "threats must not invent official siren status")
print("PASS independent threat synchronization, silent-connection gate and snapshot recovery")

assert(threats.classify(nil, localThreat, selected, NOW * 1000) == "new")
assert(threats.classify(localThreat, localThreat, selected, NOW * 1000) == nil)
assert(threats.classify(localThreat, decoded("timestamp-only").data, selected, (NOW + 1) * 1000) == nil)
assert(threats.classify(localThreat, decoded("sub-degree").data, selected, NOW * 1000) == nil)
assert(threats.classify(localThreat, decoded("one-degree").data, selected, NOW * 1000) == nil)
assert(threats.classify(decoded("outside").data, decoded("moves-in").data, selected, NOW * 1000) == "entered")
assert(threats.classify(localThreat, decoded("leave-known").data, selected, NOW * 1000) == "left")
assert(threats.classify(localThreat, nil, selected, NOW * 1000) == "removed")
assert(threats.classify(nil, nil, selected, NOW * 1000) == nil)
assert(threats.classify(localThreat, decoded("conflicting-parent").data, selected, NOW * 1000) == nil)
assert(threats.classify(localThreat, decoded("stale-known").data, selected, NOW * 1000) == "stale")
assert(threats.classify(decoded("stale-known").data, decoded("stale-known").data, selected, NOW * 1000) == nil)
assert(threats.classify(decoded("stale-known").data, localThreat, selected, NOW * 1000) == "update")
assert(threats.classify(localThreat, decoded("resolved-known").data, selected, NOW * 1000) == "resolved")
assert(threats.classify(decoded("resolved-known").data, localThreat, selected, NOW * 1000) == "update")
assert(threats.classify(nil, decoded("stale-known").data, selected, NOW * 1000) == nil)
for key, value in pairs({ type = "missile", title = "New report", count = 3, locality = "New place", explanationShort = "New course", advisory = true, areaOnly = true }) do
    local changed = table.clone(localThreat)
    changed[key] = value
    assert(threats.classify(localThreat, changed, selected, NOW * 1000) == "update", key)
end
print("PASS new/update/entered/left/stale/resolved/removed classification and timestamp-only suppression")

local lifecycle = serviceFor(selected.key)
push(lifecycle, "snapshot")
push(lifecycle, "baseline-update")
assert(#lifecycle.notifications == 1)
assert(lifecycle.notifications[1].summary:find("Оновлення цілі", 1, true), "a known snapshot target must be labeled update")
push(lifecycle, "baseline-update")
assert(#lifecycle.notifications == 1)
push(lifecycle, "local")
assert(#lifecycle.notifications == 2 and lifecycle.notifications[2].summary:find("Нова ціль", 1, true))
lifecycle.now = NOW + 1
push(lifecycle, "timestamp-only")
push(lifecycle, "sub-degree")
assert(#lifecycle.notifications == 2, "timestamps and unrendered course precision are not content changes")
push(lifecycle, "one-degree")
assert(#lifecycle.notifications == 2, "heading-only changes must not notify")
push(lifecycle, "update-local")
assert(#lifecycle.notifications == 3 and lifecycle.notifications[3].body:find("Гнідин", 1, true))
push(lifecycle, "stale-known")
assert(#lifecycle.notifications == 4 and lifecycle.notifications[4].summary:find("Дані застаріли", 1, true))
assert(lifecycle.notifications[4].urgency == "normal")
assert(not lifecycle.notifications[4].body:find("Останні дані", 1, true))
assert(lifecycle.notifications[4].body:sub(1, #"• ") == "• ")
assert(not lifecycle.notifications[4].body:find("відбій", 1, true))
push(lifecycle, "stale-known")
assert(#lifecycle.notifications == 4)
push(lifecycle, "resolved-known")
assert(#lifecycle.notifications == 5 and lifecycle.notifications[5].summary:find("Позначку закрито", 1, true))
assert(lifecycle.notifications[5].urgency == "normal")
push(lifecycle, "local")
assert(#lifecycle.notifications == 6 and lifecycle.notifications[6].summary:find("Оновлення цілі", 1, true))
push(lifecycle, "leave-known")
assert(#lifecycle.notifications == 7 and lifecycle.notifications[7].summary:find("поза регіоном", 1, true))
assert(lifecycle.notifications[7].urgency == "normal")
push(lifecycle, "leave-known")
assert(#lifecycle.notifications == 7)
push(lifecycle, "local")
assert(#lifecycle.notifications == 8 and lifecycle.notifications[8].summary:find("в регіоні", 1, true))
push(lifecycle, "remove")
assert(#lifecycle.notifications == 9 and lifecycle.notifications[9].summary:find("Ціль втрачено", 1, true))
assert(lifecycle.notifications[9].urgency == "normal")
assert(lifecycle.notifications[9].timeout_ms == 5000)
for index = 2, 9 do
    assert(not lifecycle.notifications[index].body:find("new-local", 1, true), "technical IDs stay hidden")
end
push(lifecycle, "remove")
assert(#lifecycle.notifications == 9)
assert(lifecycle.streamAttempts == 1 and #lifecycle.requests == 0)
print("PASS labeled target lifecycle, compact content, one notification per change and normal-priority inactive events")

local newOnly = serviceFor(selected.key)
newOnly.config.threat_notifications = "new_only"
push(newOnly, "snapshot")
push(newOnly, "local")
assert(#newOnly.notifications == 1)
push(newOnly, "update-local")
assert(#newOnly.notifications == 1, "new-only mode suppresses updates")
local latest
for _, threat in ipairs(newOnly.values.currentThreats.threats) do
    if threat.id == "new-local" then
        latest = threat
    end
end
assert(latest.locality == "Гнідин" and latest.count == 3, "suppressed notifications still update panel data")
newOnly.config.threat_notifications = "new_and_updates"
push(newOnly, "update-local")
assert(#newOnly.notifications == 1, "changing modes does not replay an unchanged target")
push(newOnly, "one-degree")
assert(#newOnly.notifications == 2 and newOnly.notifications[2].summary:find("Оновлення цілі", 1, true))
push(newOnly, "stale-known")
assert(#newOnly.notifications == 3)
newOnly.config.threat_notifications = "new_only"
push(newOnly, "resolved-known")
push(newOnly, "remove")
assert(#newOnly.notifications == 3, "new-only mode also suppresses inactive lifecycle updates")
push(newOnly, "outside")
push(newOnly, "moves-in")
assert(#newOnly.notifications == 4, "first appearance in scope still counts as new for this region")
assert(newOnly.streamAttempts == 1 and #newOnly.requests == 0)
local missingCount = presentation.details(decoded("invalid-optional").data)[1]
assert(missingCount == "БпЛА", "an omitted source count must not display a placeholder")
local official = serviceFor("київська")
official.config.threat_notifications = "new_only"
push(official, "empty-alerts")
send(official, "red")
assert(#official.notifications == 1 and official.values.alertStatus.kind == "alert", "official siren notifications are independent of target settings")
print("PASS plugin notification modes, live mode changes, independent panel/siren updates and unknown counts")
